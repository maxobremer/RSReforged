{
	"id": "rsreforged",
	"title": "RSReforged (GMC fork)",
	"description": "Personal GMC fork of RSReforged (Ready Set Roll for D&D5e): one-card quick rolls for dnd5e 6 rendered in the system's compact chat style, always-two-d20 multiroll with retroactive advantage/disadvantage, bonuses and crits from the roll breakdown, fast-forward rolls with Shift to configure, fully hidden private rolls with a GM reveal button, and a damage tray facelift. Not distributed; updates are manual.",
	"version": "5.0.0-gmc",
	"compatibility": {
		"minimum": "14.367",
		"verified": "14.368",
		"maximum": "14"
	},
